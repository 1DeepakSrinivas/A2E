# Copy to .env. The runner reads it at start-up; a variable already set in the shell wins.

# Share the Worker settings with the a2e-results project instead of copying them.
# The runner takes only WORKER_URL and WRITE_TOKEN from this file, so the device never sees READ_TOKEN.
# On a device that has no a2e-results checkout, leave this out and set the two variables below.
A2E_RESULTS_ENV=../a2e-results/.env

# Worker that stores results. Only needed when A2E_RESULTS_ENV is not used.
# WORKER_URL=https://a2e-results.<account>.workers.dev

# Must equal the WRITE_TOKEN secret set on the Worker. Only needed when A2E_RESULTS_ENV is not used.
# WRITE_TOKEN=

# Live web search suite only
BRAVE_SEARCH_API_KEY=

# Optional: override the detected user@hostname used to pick configs/hosts/<id>.toml
# A2E_HOST_ID=
