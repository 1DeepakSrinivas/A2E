        "tools": [
          "device_list"
        ],
        "successes": 1
      }
    ]
  },
  {
    "id": "tool-error-dev",
    "split": "dev",
    "family": "edge",
    "prompt": "Read reading.txt. If the read fails temporarily, retry it once. Copy the contents to result.txt.",
    "tools": [
      "read_file",
      "write_file"
    ],
    "required_calls": 2,
    "fixtures": {
      "files": {
        "reading.txt": "42"
      },
      "fail_once": {
        "read_file": 1
      }
    },
    "checks": [
      {
        "kind": "file_eq",
        "key": "result.txt",
        "expected": "42"
      }
    ],
    "stages": [
      {
        "instruction": "Read reading.txt; retry once if it fails temporarily.",
        "tools": [
          "read_file"
        ],
        "successes": 1
      },
      {
        "instruction": "Copy the returned content to result.txt.",
        "tools": [
          "write_file"
        ],
        "successes": 1
      }
    ]
  },
