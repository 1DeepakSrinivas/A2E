[
  {
    "id": "missing-argument-dev",
    "split": "dev",
    "family": "edge",
    "prompt": "A device should be adjusted, but its name and setting have not been supplied. Ask for both values without changing any setting.",
    "tools": [
      "device_status",
      "set_setting"
    ],
    "required_calls": 1,
    "fixtures": {
      "devices": {
        "cooler": {
          "temperature": 35,
          "setting": 20
        }
      }
    },
    "checks": [
      {
        "kind": "no_call",
        "key": "set_setting",
        "expected": null
      },
      {
        "kind": "answer_contains",
        "key": "",
        "expected": "name"
      },
      {
        "kind": "answer_contains",
        "key": "",
        "expected": "setting"
      }
    ],
    "stages": [
      {
        "instruction": "Ask for the missing device name and setting; do not guess.",
        "tools": [
          "device_status"
        ],
        "successes": 1
      }
    ]
  },
  {
    "id": "irrelevant-dev",
